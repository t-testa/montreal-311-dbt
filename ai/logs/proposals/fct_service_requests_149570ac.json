 "payload_sent": {
  "model_name": "fct_service_requests",
  "model_sql": "-- Fact table. Grain: one row per request_id.\n\nselect\n    request_id,\n\n    -- Foreign keys. coalesce(<key>, <unknown>) routes missing values to the Unknown member.\n    {{ date_key('created_at') }}                                        as created_date_key,\n    {{ date_key('last_status_at') }}                                    as last_status_date_key,\n    coalesce({{ dim_key('activity_name') }}, {{ unknown_key() }})       as activity_key,\n    -- Role-playing dimension: two keys into dim_borough.\n    coalesce({{ dim_key('borough') }}, {{ unknown_key() }})             as responsible_borough_key,\n    coalesce({{ dim_key('borough_geo') }}, {{ unknown_key() }})         as location_borough_key,\n\n    request_base_id,\n    request_id_suffix,\n    is_unexpected_id_prefix,\n    contact_nature,\n    created_at,\n    last_status,\n    last_status_at,\n    is_closed,\n    closed_outcome,\n    resolution_days,\n    original_channel,\n    phone_contact_count,\n    email_contact_count,\n    in_person_contact_count,\n    mail_contact_count,\n    fax_contact_count,\n    council_contact_count,\n    mobile_app_contact_count,\n    social_media_contact_count,\n    website_contact_count,\n    responsible_unit,\n    location_type,\n    street,\n    postal_code,\n    latitude,\n    longitude,\n    has_geocoding_error,\n    borough_mismatch\nfrom {{ ref('int_311__service_requests') }}\n",
  "model_yml": "version: 2\n\nmodels:\n  - name: dim_date\n    description: Calendar dimension, one row per day from the earliest to the latest date in the data. Generated in SQL.\n    columns:\n      - name: date_key\n        description: Integer yyyymmdd (primary key).\n        data_tests: [unique, not_null]\n      - name: date_day\n        description: The calendar date.\n      - name: year\n        description: Calendar year.\n      - name: quarter\n        description: Calendar quarter, 1-4.\n      - name: month\n        description: Month number, 1-12.\n      - name: month_name\n        description: English month name.\n      - name: day_of_month\n        description: Day of the month.\n      - name: day_of_week\n        description: ISO day of week, 1 = Monday to 7 = Sunday.\n      - name: day_name\n        description: English weekday name.\n      - name: is_weekend\n        description: True for Saturday and Sunday.\n      - name: week_start_date\n        description: Monday of the week containing the date.\n\n  - name: dim_borough\n    description: >\n      One row per normalized borough value found in either borough column, plus an Unknown\n      member. Role-playing dimension joined twice by fct_service_requests.\n    columns:\n      - name: borough_key\n        description: Surrogate key, md5 of the borough name (primary key). The Unknown member has a reserved key.\n        data_tests: [unique, not_null]\n      - name: borough_name\n        description: Borough or municipality name in 'A-B' format, or 'Unknown'.\n      - name: is_non_borough_value\n        description: True for placeholder values that are not real boroughs (Ville de Montréal, Extérieur de Montréal).\n      - name: is_unknown_member\n        description: True only for the Unknown row, which facts point at when a borough is missing.\n\n  - name: dim_activity\n    description: >\n      One row per activity (source ACTI_NOM), plus an Unknown member for missing names. Carries\n      no nature or location-type columns because an activity occurs under several natures.\n    columns:\n      - name: activity_key\n        description: Surrogate key, md5 of the activity name (primary key).\n        data_tests: [unique, not_null]\n      - name: activity_name\n        description: Activity name (French), or 'Unknown'.\n      - name: is_unknown_member\n        description: True only for the Unknown row.\n\n  - name: fct_service_requests\n    description: Requests, complaints and comments. Grain is one row per request_id.\n    columns:\n      - name: request_id\n        description: Request identifier (primary key).\n        data_tests: [unique, not_null]\n      - name: created_date_key\n        description: Foreign key to dim_date for the creation date.\n      - name: last_status_date_key\n        description: Foreign key to dim_date for the last status date.\n      - name: activity_key\n        description: Foreign key to dim_activity. Points at the Unknown member when the activity is missing.\n      - name: responsible_borough_key\n        description: Foreign key to dim_borough from the recorded borough (source ARRONDISSEMENT). Unknown member when missing.\n      - name: location_borough_key\n        description: Foreign key to dim_borough from the geocoded borough (source ARRONDISSEMENT_GEO). Unknown member when missing.\n      - name: request_base_id\n        description: request_id without its '-A'/'-B' suffix.\n      - name: request_id_suffix\n        description: Letter suffix of request_id, or null.\n      - name: is_unexpected_id_prefix\n        description: True when request_id starts with '20-' or '21-'.\n      - name: contact_nature\n        description: Requete, Plainte or Commentaire.\n      - name: created_at\n        description: Creation time, Montreal local time.\n      - name: last_status\n        description: Most recent status (French).\n      - name: last_status_at\n        description: Time of the most recent status change, Montreal local time.\n      - name: is_closed\n        description: True when the status is terminal per the status_mapping seed.\n      - name: closed_outcome\n        description: completed, refused, cancelled or deleted; null while open.\n      - name: resolution_days\n        description: Fractional days from creation to last status, only for closed requests (last_status_at is a proxy for close time).\n      - name: original_channel\n        description: Channel the request first arrived through.\n      - name: phone_contact_count\n        description: Times reported by telephone.\n      - name: email_contact_count\n        description: Times reported by email.\n      - name: in_person_contact_count\n        description: Times reported in person.\n      - name: mail_contact_count\n        description: Times reported by postal mail.\n      - name: fax_contact_count\n        description: Times reported by fax.\n      - name: council_contact_count\n        description: Times reported through a municipal body or council.\n      - name: mobile_app_contact_count\n        description: Times reported through the mobile app.\n      - name: social_media_contact_count\n        description: Times reported through social media.\n      - name: website_contact_count\n        description: Times reported through the website.\n      - name: responsible_unit\n        description: Responsible organizational unit as text; deliberately not joined to dim_borough.\n      - name: location_type\n        description: Adresse, Intersection, Troncon or Installation.\n      - name: street\n        description: Street name of the location.\n      - name: postal_code\n        description: Postal code, uppercase, no spaces.\n      - name: latitude\n        description: WGS84 latitude.\n      - name: longitude\n        description: WGS84 longitude.\n      - name: has_geocoding_error\n        description: True when the city flagged a geocoding error.\n      - name: borough_mismatch\n        description: True when the recorded and geocoded boroughs are both present and differ.\n\n  - name: fct_information_contacts\n    description: Information calls with no request_id. Grain is one row per contact_sk.\n    columns:\n      - name: contact_sk\n        description: Surrogate key (primary key).\n        data_tests: [unique, not_null]\n      - name: created_date_key\n        description: Foreign key to dim_date for the call date.\n      - name: activity_key\n        description: Foreign key to dim_activity. Unknown member when missing.\n      - name: contact_nature\n        description: Always 'Information'.\n      - name: created_at\n        description: Call time, Montreal local time.\n      - name: original_channel\n        description: Channel the contact arrived through.\n      - name: phone_contact_count\n        description: Times reported by telephone.\n      - name: email_contact_count\n        description: Times reported by email.\n      - name: in_person_contact_count\n        description: Times reported in person.\n      - name: mail_contact_count\n        description: Times reported by postal mail.\n      - name: fax_contact_count\n        description: Times reported by fax.\n      - name: council_contact_count\n        description: Times reported through a municipal body or council.\n      - name: mobile_app_contact_count\n        description: Times reported through the mobile app.\n      - name: social_media_contact_count\n        description: Times reported through social media.\n      - name: website_contact_count\n        description: Times reported through the website.\n      - name: responsible_unit\n        description: Responsible organizational unit (text).\n      - name: is_exact_duplicate\n        description: True when the row has identical copies across every source column.\n",
